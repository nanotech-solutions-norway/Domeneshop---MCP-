# D-R3 isolated DNS TXT pilot runtime template
# Copy outside the repository and restrict it to the runtime service account.
# Do not place real values in Git, chat, logs, screenshots, or workflow output.

DS_PILOT_DOMAIN_NAME=__SET_IN_PROTECTED_SECRET_STORE__
DS_PILOT_TXT_HOST=_mcp-validation

# Safety defaults stay locked during registration and GET-only preflight.
WRITE_TOOLS_ENABLED=false
DRY_RUN_DEFAULT=true
REQUIRE_OPERATOR_APPROVAL=true
REQUIRE_BACKUP_EVIDENCE=true
REQUIRE_PREFLIGHT_REPORT=true

# Required only for a later separately approved controlled-write runtime.
APPROVAL_SIGNING_SECRET=__SET_IN_PROTECTED_SECRET_STORE__
APPROVAL_NONCE_DIR=__SET_ABSOLUTE_SERVER_PATH__
IDEMPOTENCY_DIR=__SET_ABSOLUTE_SERVER_PATH__
CONTROLLED_WRITE_AUDIT_FILE=__SET_ABSOLUTE_SERVER_PATH__
CONTROLLED_WRITE_RELEASE_MANIFEST=__SET_ABSOLUTE_SERVER_PATH__
